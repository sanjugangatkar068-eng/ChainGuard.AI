# Copy this file to .env and adjust as needed.

# --- App ---
APP_NAME=ChainGuard AI
DATABASE_PATH=chainguard.db

# --- LLM (optional) ---
# Leave LLM_PROVIDER=none to use the built-in rules-based reasoning.
# Supported providers: none, openai, anthropic
LLM_PROVIDER=none
LLM_API_KEY=
LLM_MODEL=
# Optional: override the API base URL (e.g. for an OpenAI-compatible endpoint).
LLM_BASE_URL=

# --- External signals (optional) ---
# Comma-separated RSS/Atom feed URLs for the Disruption Sensing Agent.
# If unset, a small default set is used and an offline sample is the fallback.
SIGNAL_FEEDS=
