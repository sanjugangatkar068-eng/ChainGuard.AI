# Copy this file to .env and adjust as needed.

# --- App ---
APP_NAME=ChainGuard AI
DATABASE_PATH=chainguard.db

# Comma-separated list of allowed browser origins (the React frontend).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- LLM (optional) ---
# Leave LLM_PROVIDER=none to use the built-in rules-based reasoning.
# Supported providers: none, openai, anthropic
LLM_PROVIDER=none
LLM_API_KEY=
LLM_MODEL=
# Optional: override the API base URL (e.g. for an OpenAI-compatible endpoint).
LLM_BASE_URL=

# --- Alerts / escalation (optional) ---
# Escalate (and alert) only when the risk level reaches this threshold.
ALERT_MIN_LEVEL=high
# Optional webhook URL; alerts are POSTed here as JSON. If empty, alerts are
# recorded in the database with channel "log" and nothing is sent.
ALERT_WEBHOOK_URL=

# --- External signals (optional) ---
# Comma-separated RSS/Atom feed URLs for the Disruption Sensing Agent.
# If unset, a small default set is used and an offline sample is the fallback.
SIGNAL_FEEDS=
